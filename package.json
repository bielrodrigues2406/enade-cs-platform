{
  "name": "enade-cs-platform",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "db:up": "node scripts/local-env.mjs && docker compose up -d --wait db",
    "db:migrate": "node scripts/migrate.mjs",
    "db:seed": "tsx scripts/seed.ts",
    "dev:api": "tsx --tsconfig apps/api/tsconfig.json apps/api/src/serve.ts",
    "dev:web": "ng serve web --host 0.0.0.0",
    "build": "tsc -p apps/api/tsconfig.json && ng build web",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "curator:role": "tsx scripts/curator-role.ts",
    "import:source": "tsx scripts/import-source.ts",
    "download:sources": "node scripts/download-sources.mjs",
    "import:sources": "node scripts/import-sources.mjs",
    "build:admin": "esbuild scripts/curator-role.ts scripts/seed.ts --bundle --platform=node --format=esm --packages=external --outdir=dist/admin --out-extension:.js=.mjs",
    "extract:questions": "node scripts/extract-questions.mjs"
  },
  "dependencies": {
    "@angular/common": "22.2.3",
    "@angular/compiler": "22.2.3",
    "@angular/core": "22.2.3",
    "@angular/forms": "22.2.3",
    "@angular/platform-browser": "22.2.3",
    "@fontsource-variable/figtree": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/source-serif-4": "5.3.0",
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "@nestjs/platform-express": "12.2.0",
    "dotenv": "18.0.9",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@angular/build": "22.2.3",
    "@angular/cli": "22.2.3",
    "@angular/compiler-cli": "22.2.3",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  },
  "type": "module",
  "overrides": {
    "multer": "2.5.0"
  }
}
