# Copie para /srv/apps/enade/.env (só o dono lê: chmod 600 .env).
# Senha do banco: openssl rand -hex 24
POSTGRES_PASSWORD=
# Endereço público HTTPS, sem barra no fim.
APP_ORIGIN=https://enade.mirasalgados.com.br
# Seu e-mail: vira o primeiro administrador ao criar a conta no site.
ADMIN_EMAILS=
# Versão da imagem: latest ou os 7 primeiros caracteres de um commit da main.
VERSAO=latest
