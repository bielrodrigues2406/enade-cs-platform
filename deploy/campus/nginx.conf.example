# Exemplo de virtual host Nginx para o servidor do câmpus IFSP.
# Adapte server_name e os caminhos do certificado TLS institucional.

server {
    listen 80;
    listen [::]:80;
    server_name enade.pep.ifsp.edu.br;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name enade.pep.ifsp.edu.br;

    ssl_certificate     /etc/ssl/certs/enade.pep.ifsp.edu.br.fullchain.pem;
    ssl_certificate_key /etc/ssl/private/enade.pep.ifsp.edu.br.privkey.pem;

    # Necessário para importação administrativa de provas (até 3 PDFs de 10 MB em POST /api/imports).
    client_max_body_size 35m;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }
}
