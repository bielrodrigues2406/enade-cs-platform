# Copie para deploy/campus/.env e restrinja a leitura ao operador:
#   cp .env.example .env && chmod 600 .env

# Senha do PostgreSQL interno (gere com: openssl rand -hex 24)
POSTGRES_PASSWORD=

# Origem pública HTTPS exata, sem barra no final (ex.: https://enade.pep.ifsp.edu.br)
APP_ORIGIN=https://enade.pep.ifsp.edu.br

# Endereço e porta no host onde o proxy reverso do câmpus alcança o contêiner.
# Mantenha 127.0.0.1 quando o proxy reverso (Nginx/Apache/Caddy) roda na mesma VM.
# Se o proxy institucional estiver em outro servidor da rede interna do câmpus,
# informe o IP interno desta VM (ex.: 10.0.10.25) e restrinja a porta no firewall.
APP_BIND=127.0.0.1
APP_PORT=3000

# Quantidade de proxies reversos confiáveis antes da aplicação (0 a 3).
# Use 1 quando houver apenas o proxy reverso do câmpus; 2 se houver Cloudflare/WAF + proxy local.
TRUST_PROXY=1

# Carga automática das provas oficiais conferidas ao subir (1 = ligada, 0 = desligada).
BOOTSTRAP_CONTENT=1

# Tag da imagem quando usar pull do GHCR (ex.: latest ou SHA curto de 7 caracteres da main).
VERSAO=latest
